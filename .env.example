# Optional environment variables are commented. Uncomment to customize them.
# APP_NAME="Python Project Template"
# APP_VERSION="0.1.0"
# APP_ENV="local"
# APP_PROD_ENV_NAME="prod"
# LOG_LEVEL="INFO"

# API service settings
# API_HOST="127.0.0.1"
# API_PORT=8000
# API_RELOAD=True
# Keep default value 1 for local development and some production environments (for ex. in Kubernetes ReplicaSets).
# In production, you may want to increase this value based on your server capacity.
# Standard formula: (2 x CPU Cores) + 1
# API_WORKERS_COUNT=1

# Docker image configuration
IMAGE_NAME=py-app-api
IMAGE_TAG=dev

# PostgreSQL optional extension (requires uv --extra postgres)
# POSTGRES_ENABLED=false
# POSTGRES_USER=app
# POSTGRES_PASSWORD=devpassword
# POSTGRES_DB=appdb
# POSTGRES_PORT=5432
# local service URL
# POSTGRES_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}"
# postgres service URL for docker compose
# POSTGRES_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_PORT}/${POSTGRES_DB}"

# Docker Compose profile
# COMPOSE_PROFILES=postgres
# UV_EXTRAS=--extra postgres